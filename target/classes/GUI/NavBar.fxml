<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>


<HBox fx:controller="controller.NavBarController" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="70.0" spacing="20.0" styleClass="nav-bar" stylesheets="@../Assets/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../Assets/Icons/Logo.png" />
            </image>
        </ImageView>
        <Label styleClass="nav-title" text="AGAPAY" />
        <Region HBox.hgrow="ALWAYS" />
        <Label styleClass="nav-label" text="TEXT SIZE:" />

       
        <HBox styleClass="size-pill-container">
            <children>
                
                <Button mnemonicParsing="false" onAction="#decreaseTextSize" text="A-">
                    <styleClass>
                        <String fx:value="pill-button" />
                        <String fx:value="pill-button-bordered" />
                    </styleClass>
                </Button>
                
                <Button mnemonicParsing="false" onAction="#resetTextSize" text="A">
                    <styleClass>
                        <String fx:value="pill-button" />
                        <String fx:value="pill-button-bordered" />
                    </styleClass>
                </Button>
               
                <Button mnemonicParsing="false" onAction="#increaseTextSize" styleClass="pill-button" text="A+" />
            </children>
        </HBox>


        <Button mnemonicParsing="false" onAction="#resetTextSize" styleClass="nav-button-default" text="DEFAULT" />
    </children>
</HBox>